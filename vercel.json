{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "main.py"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend(/.*)?",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/((?!_next/image).*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ]
}
