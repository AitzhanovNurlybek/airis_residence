# ──────────────────────────────────────────────────────────────
#  Airis Residence — переменные окружения (фронтенд)
#  Скопируй файл в .env.local и заполни. .env.local в git не попадает.
# ──────────────────────────────────────────────────────────────

# ═══ 1. БРОНИРОВАНИЕ ═══════════════════════════════════════════
# Пока пусто — кнопка «Забронировать» ведёт на форму заявки /bronirovanie.
# Ничего не ломается, заявки продолжают приходить.

# Режим: engine | widget | request  (можно не указывать — определится сам)
NEXT_PUBLIC_BOOKING_MODE=

# ВАРИАНТ А. Банк/движок дал ССЫЛКУ на бронирование или оплату:
NEXT_PUBLIC_BOOKING_URL=

# Как движок называет параметры в ссылке (менять, только если у вендора иначе)
NEXT_PUBLIC_BOOKING_PARAM_CHECKIN=checkin
NEXT_PUBLIC_BOOKING_PARAM_CHECKOUT=checkout
NEXT_PUBLIC_BOOKING_PARAM_ADULTS=adults
NEXT_PUBLIC_BOOKING_PARAM_ROOM=room

# ВАРИАНТ Б. Банк/движок дал КОД ВИДЖЕТА (script + div):
NEXT_PUBLIC_BOOKING_WIDGET_SRC=
NEXT_PUBLIC_BOOKING_WIDGET_HTML=

# ═══ 2. 3D-ТУР ═════════════════════════════════════════════════
# Ссылка на встраиваемый тур (Kuula, Matterport, Pannellum, свой плеер).
# Пусто — на месте тура красивая заглушка.
NEXT_PUBLIC_TOUR_3D_URL=

# ═══ 3. КУДА ПАДАЮТ ЗАЯВКИ ═════════════════════════════════════
# Telegram: бот создаётся у @BotFather, chat_id — у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ 4. БЭКЕНД И АДМИН-ПАНЕЛЬ ══════════════════════════════════
# Адрес FastAPI из папки backend/. Локально: http://localhost:8000
#
# Пока пусто:
#   · номера берутся из lib/site.ts (правятся только в коде);
#   · заявки уходят напрямую в Telegram;
#   · админка на /admin показывает подсказку и не работает.
#
# Как только адрес указан:
#   · сайт берёт номера, цены и фото из базы;
#   · на /admin можно всё это менять без программиста.
BACKEND_URL=
BACKEND_API_KEY=

# Если фронт и бэк на разных доменах и форма должна ходить напрямую в бэк:
NEXT_PUBLIC_API_BASE_URL=

# Домен, с которого отдаются загруженные фото, если он отличается от BACKEND_URL
# (например, когда файлы вынесены на CDN). Обычно оставить пустым.
NEXT_PUBLIC_MEDIA_BASE=
