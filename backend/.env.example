# ──────────────────────────────────────────────────────────────
#  Airis Residence — переменные окружения (бэкенд)
#  Скопировать в .env и заполнить. .env в git не попадает.
# ──────────────────────────────────────────────────────────────

DEBUG=false

# База. SQLite годится для старта; на проде — PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/airis
DATABASE_URL=sqlite+aiosqlite:///./airis.db

# Домены фронтенда, которым разрешено обращаться к API
CORS_ORIGINS=http://localhost:3000,https://airisresidence.kz,https://www.airisresidence.kz

# Ключ для служебного доступа к заявкам по X-API-Key (для интеграций).
# Придумать длинную случайную строку. Пока пусто — эндпоинт закрыт.
API_KEY=

# ═══ ВХОД В АДМИНКУ ═══════════════════════════════════════════
# Пока ADMIN_PASSWORD или SECRET_KEY пустые — админка закрыта целиком.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Длинная случайная строка для подписи сессии. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Сколько часов держится вход до повторной авторизации
SESSION_HOURS=12

# ═══ ФОТОГРАФИИ ═══════════════════════════════════════════════
# Куда складывать загруженные из админки фото.
# ⚠️ На Railway/Render файловая система стирается при каждом деплое —
#    примонтируйте постоянный диск и укажите путь к нему.
UPLOAD_DIR=./media
# Публичный адрес бэкенда — из него собираются ссылки на фото.
# Локально можно оставить пустым, в проде обязателен.
PUBLIC_MEDIA_BASE=
MAX_UPLOAD_MB=15
# До какой ширины ужимать фото (пиксели). Больше 2200 сайту не нужно.
IMAGE_MAX_WIDTH=2200

# ═══ УВЕДОМЛЕНИЯ О ЗАЯВКАХ ════════════════════════════════════
# Бот создаётся у @BotFather, chat_id узнать у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ ПЛАТЁЖНЫЙ ШЛЮЗ — ЭТО ЗАПОЛНЯЕТ БАНК ══════════════════════
# Пока пусто — /api/payments/* отвечают 501, сайт работает без онлайн-оплаты.
#
# PAYMENT_PROVIDER: epay_halyk | fortebank
PAYMENT_PROVIDER=
PAYMENT_BASE_URL=
PAYMENT_TERMINAL_ID=
PAYMENT_CLIENT_ID=
PAYMENT_CLIENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Куда банк вернёт гостя после оплаты
PAYMENT_SUCCESS_URL=https://airisresidence.kz/oplata/uspeh
PAYMENT_FAILURE_URL=https://airisresidence.kz/oplata/oshibka
