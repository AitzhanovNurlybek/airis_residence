# ──────────────────────────────────────────────────────────────
#  Airis Residence — переменные окружения (бэкенд)
#  Скопировать в .env и заполнить. .env в git не попадает.
# ──────────────────────────────────────────────────────────────

DEBUG=false

# Внешний префикс бэкенда. На Vercel — /api/backend (см. vercel.json).
# Локально и на обычном сервере оставить пустым.
ROOT_PATH=

# ═══ БАЗА ДАННЫХ ══════════════════════════════════════════════
# Локально — файл SQLite, ничего настраивать не нужно.
DATABASE_URL=sqlite+aiosqlite:///./airis.db
#
# В облаке — PostgreSQL (Neon, Supabase):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname
# ⚠️ Брать строку подключения ЧЕРЕЗ ПУЛЕР — у Neon и Supabase это
#    отдельный адрес со словом «pooler». Обычная строка на serverless
#    быстро упрётся в лимит соединений.
# ⚠️ Из строки убрать хвост ?sslmode=require — за TLS отвечает DATABASE_SSL.
DATABASE_SSL=true

# Домены фронтенда, которым разрешено обращаться к API
CORS_ORIGINS=http://localhost:3000,https://airisresidence.kz,https://www.airisresidence.kz

# Ключ для служебного доступа к заявкам по X-API-Key (для интеграций).
# Придумать длинную случайную строку. Пока пусто — эндпоинт закрыт.
API_KEY=

# ═══ ВХОД В АДМИНКУ ═══════════════════════════════════════════
# Пока ADMIN_PASSWORD или SECRET_KEY пустые — админка закрыта целиком.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Длинная случайная строка для подписи сессии. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Сколько часов держится вход до повторной авторизации
SESSION_HOURS=12

# ═══ ФОТОГРАФИИ ═══════════════════════════════════════════════
# Два режима. Заполнены S3_* — файлы уходят в объектное хранилище,
# не заполнены — ложатся на диск. Локально проще диск.

# --- Режим «диск» ---
UPLOAD_DIR=./media
# Публичный адрес бэкенда — из него собираются ссылки на фото.
PUBLIC_MEDIA_BASE=

# --- Режим «S3» (обязателен на Vercel: диска там нет) ---
# Подходит Supabase Storage, Cloudflare R2, AWS S3, MinIO.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
# Адрес, по которому файлы открываются в браузере. У Supabase и R2 он
# отличается от адреса API — берите его из настроек бакета.
S3_PUBLIC_BASE=

# Общее для обоих режимов
MAX_UPLOAD_MB=15
# До какой ширины ужимать фото (пиксели). Больше 2200 сайту не нужно.
IMAGE_MAX_WIDTH=2200

# ═══ УВЕДОМЛЕНИЯ О ЗАЯВКАХ ════════════════════════════════════
# Бот создаётся у @BotFather, chat_id узнать у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ ПЛАТЁЖНЫЙ ШЛЮЗ — ЭТО ЗАПОЛНЯЕТ БАНК ══════════════════════
# Пока пусто — /api/payments/* отвечают 501, сайт работает без онлайн-оплаты.
#
# PAYMENT_PROVIDER: epay_halyk | fortebank
PAYMENT_PROVIDER=
PAYMENT_BASE_URL=
PAYMENT_TERMINAL_ID=
PAYMENT_CLIENT_ID=
PAYMENT_CLIENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Куда банк вернёт гостя после оплаты
PAYMENT_SUCCESS_URL=https://airisresidence.kz/oplata/uspeh
PAYMENT_FAILURE_URL=https://airisresidence.kz/oplata/oshibka

# ─── ИИ-консьерж ───────────────────────────────────────────────────────
# Ключ Anthropic. Без него помощник честно отказывается отвечать про цены,
# а не выдумывает их.
ANTHROPIC_API_KEY=

# Откуда помощник берёт факты об отеле: цены, правила, номера. Это адрес
# нашего же сайта — он собирает справку из тех же модулей, что рисуют
# страницы. Локально порт обязателен 3000: на другом помощник не найдёт
# справку и будет отвечать «не могу свериться».
SITE_URL=http://127.0.0.1:3000

# ─── Система бронирования ──────────────────────────────────────────────
# пусто    — не подключена, наличие подтверждает стойка
# exely    — настоящее наличие из Exely, только чтение
# hybrid   — наличие из Exely, брони уходят заявкой менеджеру
# local    — учебная шахматка в нашей базе, для отладки записи
# stub     — заглушка на хеше, без базы
BOOKING_SYSTEM=

# Заполняется, когда отель получит договорной доступ к API Exely.
# Порядок подключения — docs/EXELY_API.md
EXELY_BASE_URL=
EXELY_API_KEY=
EXELY_HOTEL_CODE=509506

# ─── WhatsApp через Green API ──────────────────────────────────────────
# console.green-api.com → создать инстанс → отсканировать QR телефоном отеля.
# Пусто — бот не запускается. Запуск: python backend/whatsapp_bot.py
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
# Пауза между отправками, секунды. Против блокировки номера; на свежем
# номере первую неделю лучше поставить больше.
WHATSAPP_SEND_DELAY=2
