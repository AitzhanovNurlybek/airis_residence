# ─── Секреты. Никогда не коммитить ───────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Зависимости и сборки ────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.turbo/

# ─── Python ──────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ─── Данные, которые создаёт сам проект ──────────────────────────
# База с заявками и номерами
*.db
*.sqlite3
# Фотографии, загруженные через админку
backend/media/

# ─── Системное ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vercel

# Исходники видео и медиа от заказчика — тяжёлые, в git не нужны
видео пример на корпоротивную панель/
*.mp4
*.mov

# Временные папки проверочных прогонов
backend/_*_tmp/

.env*

# Записная книжка паролей (backend/parol.py). Наружу не уходит никогда.
paroli.txt

# 3D-модель отеля: тяжёлые рендеры и исходники Higgsfield — только на диске
3d/renders/
3d/higgsfield/
3d/*.blend
3d/*.blend1
# Материалы от отеля (техпаспорт, видео) — не в git
все комнаты и план/
# Короткие сжатые ролики страницы «Отель в 3D» (переходы, входы в номера; ~22 МБ) — нужны сайту
!frontend/public/3d/*.mp4
!frontend/public/3d/rooms/*.mp4
